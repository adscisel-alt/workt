{
  "name": "panteon-nilu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Panteon Nilu — hobbystyczna przeglądarkowa gra strategiczna inspirowana mechaniką Ankh: Gods of Egypt",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke3d": "node scripts/smoke3d.mjs",
    "shot3d": "node scripts/shot3d.mjs",
    "models": "node scripts/build-models.mjs",
    "models:manifest": "node scripts/build-models.mjs --manifest",
    "pack:artifact": "npm run build && node scripts/pack-artifact.mjs"
  },
  "dependencies": {
    "@pmndrs/assets": "^1.7.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "draco3dgltf": "^1.5.7",
    "jsdom": "^29.1.1",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
